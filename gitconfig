[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[pull]
	rebase = false

[color]
	ui = auto

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate --all
