{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "source": "endeavouros"
    },

    "display": {
        "separator": "    ",
        "color": {
            "keys": "blue",
            "title": "magenta"
        },
        "key": {
            "width": 14
        }
    },

    "modules": [
        "title",
        "separator",

        {
            "type": "os",
            "key": "󰣇 OS"
        },

        {
            "type": "host",
            "key": "󰌢 Host"
        },

        {
            "type": "kernel",
            "key": "󰒋 Kernel"
        },

        {
            "type": "uptime",
            "key": "󰅐 Uptime"
        },

        {
            "type": "packages",
            "key": "󰏖 Packages"
        },

        {
            "type": "shell",
            "key": " Shell"
        },

        {
            "type": "display",
            "key": "󰍹 Display"
        },

        {
            "type": "wm",
            "key": " WM"
        },

        {
            "type": "terminal",
            "key": " Terminal"
        },

        {
            "type": "cpu",
            "key": " CPU"
        },

        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },

        {
            "type": "memory",
            "key": " Memory"
        },

        {
            "type": "disk",
            "key": " Disk"
        },

        {
            "type": "localip",
            "key": "󰩟 Local IP"
        },

        "break",
        "colors"
    ]
}
